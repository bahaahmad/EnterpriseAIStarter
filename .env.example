# EnterpriseAIStarter — Phase 0 laptop environment. Single source of truth for every setting.
# Read by: docker compose, rag-service (Spring config import), eval harness, scripts.
# Rules: KEY=value only. No quotes, no inline comments (Spring parses this file as .properties).
# Passwords are deliberately simple — synthetic data on a laptop only. Never reuse on the server.

# ---------- Images (pin by digest before Phase 0 exit, REQ-SUP-02)
IMG_POSTGRES=pgvector/pgvector:pg16
IMG_OLLAMA=ollama/ollama:latest
IMG_LITELLM=ghcr.io/berriai/litellm:main-stable
IMG_OPENWEBUI=ghcr.io/open-webui/open-webui:main
IMG_PRESIDIO_ANALYZER=mcr.microsoft.com/presidio-analyzer:latest
IMG_PRESIDIO_ANONYMIZER=mcr.microsoft.com/presidio-anonymizer:latest
IMG_DOCLING=quay.io/docling-project/docling-serve:latest
IMG_PHOENIX=arizephoenix/phoenix:latest
IMG_KEYCLOAK=quay.io/keycloak/keycloak:26.0
IMG_TEI_CPU=ghcr.io/huggingface/text-embeddings-inference:cpu-1.5

# ---------- Values changed by scripts/stage.sh — do not edit by hand unless you know why
# Gateway config: config.stage1.yaml (dev, ingest) or config.full.yaml (full, eval)
LITELLM_CONFIG=config.stage1.yaml
# Memory ceiling for the Ollama container: 5g normally, 7g for the 8B judge run
OLLAMA_MEM=5g

# ---------- Passwords
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_pw
RAG_READER_PASSWORD=rag_reader_pw
KEYCLOAK_ADMIN_PASSWORD=keycloak_pw
WEBUI_SECRET_KEY=webui_secret

# ---------- API keys (LiteLLM requires the sk- prefix)
# Master key: admin, scripts and eval only
LITELLM_MASTER_KEY=sk-litellm-master
# Scoped gateway keys, created with these exact values by scripts/create-keys.sh
RAG_GATEWAY_KEY=sk-rag-gateway-key
OPENWEBUI_KEY=sk-openwebui-key-01
# Key LiteLLM presents to rag-service; rag-service rejects calls without it
RAG_SERVICE_KEY=sk-rag-service-key

# ---------- Endpoints as seen from containers
OLLAMA_API_BASE=http://ollama:11434
RAG_SERVICE_URL=http://host.docker.internal:8081/v1

# ---------- rag-service (run from IntelliJ on the host; the container overrides these in docker-compose.yml)
RAG_DB_URL=jdbc:postgresql://localhost:5432/kb
RAG_GATEWAY_URL=http://localhost:4000/v1
RAG_DOCLING_URL=http://localhost:5010
RAG_CORPUS_DIR=../data/corpus
RAG_USERS_FILE=../config/identity/users.yaml
RAG_OTLP_ENDPOINT=http://localhost:6006/v1/traces

# ---------- Eval harness (host)
EVAL_RAG_URL=http://localhost:8081/v1/chat/completions
EVAL_GATEWAY_URL=http://localhost:4000/v1/chat/completions
EVAL_JUDGE_MODEL=chat-quality
EVAL_TIMEOUT_S=1800
